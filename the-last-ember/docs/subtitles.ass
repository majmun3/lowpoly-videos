Dialogue: 0,0:00:00.25,0:00:04.60,Hook,,0,0,0,,{\fad(250,300)}WHAT IF A WANDERING KNIGHT\NBECAME THE {\c&H3C9CFF&}FINAL GUARDIAN{\c&HF2F4F6&}?
Dialogue: 0,0:00:00.30,0:00:01.99,Sub,,0,0,0,,{\c&HF2F4F6&}THE LAST FIRE IN THE WORLD
Dialogue: 0,0:00:01.91,0:00:03.04,Sub,,0,0,0,,{\c&HF2F4F6&}CALLED MY NAME.
Dialogue: 0,0:00:03.05,0:00:03.94,Sub,,0,0,0,,{\c&HF2F4F6&}I SHOULD NEVER
Dialogue: 0,0:00:03.86,0:00:04.75,Sub,,0,0,0,,{\c&HF2F4F6&}HAVE ANSWERED.
Dialogue: 0,0:00:05.40,0:00:06.87,Sub,,0,0,0,,{\c&HF2F4F6&}FOR A THOUSAND YEARS,
Dialogue: 0,0:00:06.79,0:00:07.95,Sub,,0,0,0,,{\c&HF2F4F6&}THE {\c&H3C9CFF&}EMBER HEART{\c&HF2F4F6&}
Dialogue: 0,0:00:07.87,0:00:09.28,Sub,,0,0,0,,{\c&HF2F4F6&}KEPT {\c&H3C9CFF&}VHALDREN{\c&HF2F4F6&} ALIVE.
Dialogue: 0,0:00:09.55,0:00:10.91,Sub,,0,0,0,,{\c&HF2F4F6&}NOW IT WAS DYING...
Dialogue: 0,0:00:10.83,0:00:11.98,Sub,,0,0,0,,{\c&HF2F4F6&}AND SO WERE WE.
Dialogue: 0,0:00:12.45,0:00:13.66,Sub,,0,0,0,,{\c&HF2F4F6&}I AM {\c&H3C9CFF&}CAEL VORN{\c&HF2F4F6&}.
Dialogue: 0,0:00:13.58,0:00:14.58,Sub,,0,0,0,,{\c&HF2F4F6&}A WANDERER,
Dialogue: 0,0:00:14.50,0:00:16.52,Sub,,0,0,0,,{\c&HF2F4F6&}WITH NO KINGDOM LEFT TO SERVE.
Dialogue: 0,0:00:17.00,0:00:18.06,Sub,,0,0,0,,{\c&HF2F4F6&}THE SOLDIERS
Dialogue: 0,0:00:17.98,0:00:19.53,Sub,,0,0,0,,{\c&HF2F4F6&}I ONCE MARCHED BESIDE
Dialogue: 0,0:00:19.45,0:00:21.00,Sub,,0,0,0,,{\c&HF2F4F6&}HAD BECOME {\c&H3C9CFF&}ASHWIGHTS{\c&HF2F4F6&}.
Dialogue: 0,0:00:21.15,0:00:22.09,Sub,,0,0,0,,{\c&HF2F4F6&}GREY SHELLS,
Dialogue: 0,0:00:22.01,0:00:23.77,Sub,,0,0,0,,{\c&HF2F4F6&}WITH NOTHING LEFT BUT HUNGER.
Dialogue: 0,0:00:24.40,0:00:26.23,Sub,,0,0,0,,{\c&HF2F4F6&}BENEATH THE BRIDGE OF ODRAN,
Dialogue: 0,0:00:26.15,0:00:27.51,Sub,,0,0,0,,{\c&HF2F4F6&}THE {\c&H3C9CFF&}KNELLWYRM{\c&HF2F4F6&} WOKE.
Dialogue: 0,0:00:27.85,0:00:29.24,Sub,,0,0,0,,{\c&HF2F4F6&}EVERY STEP IT TOOK...
Dialogue: 0,0:00:29.16,0:00:30.35,Sub,,0,0,0,,{\c&HF2F4F6&}TOLLED A FUNERAL.
Dialogue: 0,0:00:30.75,0:00:31.72,Sub,,0,0,0,,{\c&HF2F4F6&}I KILLED IT.
Dialogue: 0,0:00:31.64,0:00:32.66,Sub,,0,0,0,,{\c&HF2F4F6&}I TOLD MYSELF
Dialogue: 0,0:00:32.58,0:00:33.80,Sub,,0,0,0,,{\c&HF2F4F6&}IT WAS A {\c&H3C9CFF&}MONSTER{\c&HF2F4F6&}.
Dialogue: 0,0:00:34.60,0:00:35.61,Sub,,0,0,0,,{\c&HF2F4F6&}AT THE SUMMIT
Dialogue: 0,0:00:35.53,0:00:37.02,Sub,,0,0,0,,{\c&HF2F4F6&}OF THE {\c&H3C9CFF&}ASHEN CATHEDRAL{\c&HF2F4F6&},
Dialogue: 0,0:00:36.94,0:00:38.39,Sub,,0,0,0,,{\c&HF2F4F6&}THE HEART WAS WAITING.
Dialogue: 0,0:00:38.70,0:00:40.43,Sub,,0,0,0,,{\c&HF2F4F6&}IT DID NOT NEED A {\c&H3C9CFF&}SAVIOR{\c&HF2F4F6&}.
Dialogue: 0,0:00:41.40,0:00:42.88,Sub,,0,0,0,,{\c&HF2F4F6&}IT NEEDED A {\c&H3C9CFF&}KEEPER{\c&HF2F4F6&}.
Dialogue: 0,0:00:43.45,0:00:44.83,Sub,,0,0,0,,{\c&HF2F4F6&}CARVED IN THE STONE,
Dialogue: 0,0:00:44.75,0:00:45.93,Sub,,0,0,0,,{\c&HF2F4F6&}I SAW THE TRUTH.
Dialogue: 0,0:00:45.85,0:00:46.97,Sub,,0,0,0,,{\c&HF2F4F6&}EVERY {\c&H3C9CFF&}KEEPER{\c&HF2F4F6&}...
Dialogue: 0,0:00:46.89,0:00:48.07,Sub,,0,0,0,,{\c&HF2F4F6&}BECOMES A {\c&H3C9CFF&}BEAST{\c&HF2F4F6&}.
Dialogue: 0,0:00:48.70,0:00:49.75,Sub,,0,0,0,,{\c&HF2F4F6&}THE {\c&H3C9CFF&}KNELLWYRM{\c&HF2F4F6&}...
Dialogue: 0,0:00:49.67,0:00:50.62,Sub,,0,0,0,,{\c&HF2F4F6&}WORE {\c&H3C9CFF&}MY CREST{\c&HF2F4F6&}.
Dialogue: 0,0:00:51.30,0:00:52.74,Sub,,0,0,0,,{\c&HF2F4F6&}SOMEONE HAS TO {\c&H3C9CFF&}BURN{\c&HF2F4F6&},
Dialogue: 0,0:00:52.66,0:00:54.14,Sub,,0,0,0,,{\c&HF2F4F6&}SO THE WORLD CAN SEE.
Dialogue: 0,0:00:54.70,0:00:55.93,Sub,,0,0,0,,{\c&HF2F4F6&}THE DAWN RETURNED
Dialogue: 0,0:00:55.85,0:00:56.83,Sub,,0,0,0,,{\c&HF2F4F6&}TO {\c&H3C9CFF&}VHALDREN{\c&HF2F4F6&}.
Dialogue: 0,0:00:57.30,0:00:58.94,Sub,,0,0,0,,{\c&HF2F4F6&}AND IN A THOUSAND YEARS...
Dialogue: 0,0:00:58.86,0:01:00.01,Sub,,0,0,0,,{\c&HF2F4F6&}ANOTHER WANDERER
Dialogue: 0,0:00:59.93,0:01:01.32,Sub,,0,0,0,,{\c&HF2F4F6&}WILL COME TO {\c&H3C9CFF&}KILL ME{\c&HF2F4F6&}.
Dialogue: 0,0:01:02.00,0:01:04.00,Title,,0,0,0,,{\fad(600,0)}THE LAST EMBER
Dialogue: 0,0:01:02.50,0:01:04.00,Ask,,0,0,0,,{\fad(400,0)}WOULD YOU TAKE HIS PLACE?\N{\fs40}{\c&H3C9CFF&}TELL ME IN THE COMMENTS
