Dialogue: 0,0:00:00.00,0:00:04.20,Hook,,0,0,0,,{\fad(0,300)}WHAT IF YOU WERE\N{\c&H30B8F0&}BORN AS A GOBLIN?
Dialogue: 0,0:00:00.20,0:00:01.90,Sub,,0,0,0,,{\c&HF2F4F6&}WHAT IF YOU WERE BORN A {\c&H30B8F0&}GOBLIN{\c&HF2F4F6&}...
Dialogue: 0,0:00:01.90,0:00:02.81,Sub,,0,0,0,,{\c&HF2F4F6&}THE {\c&H30B8F0&}WEAKEST{\c&HF2F4F6&} ONE
Dialogue: 0,0:00:02.81,0:00:03.76,Sub,,0,0,0,,{\c&HF2F4F6&}IN THE FOREST?
Dialogue: 0,0:00:04.00,0:00:05.36,Sub,,0,0,0,,{\c&HF2F4F6&}YOU OPENED YOUR EYES
Dialogue: 0,0:00:05.36,0:00:06.93,Sub,,0,0,0,,{\c&HF2F4F6&}BENEATH THE GREAT TREES,
Dialogue: 0,0:00:06.93,0:00:08.64,Sub,,0,0,0,,{\c&HF2F4F6&}SURROUNDED BY YOUR TRIBE.
Dialogue: 0,0:00:08.90,0:00:09.99,Sub,,0,0,0,,{\c&HF2F4F6&}BUT YOU WERE {\c&H30B8F0&}SMALLER{\c&HF2F4F6&}
Dialogue: 0,0:00:09.99,0:00:11.04,Sub,,0,0,0,,{\c&HF2F4F6&}THAN ALL OF THEM.
Dialogue: 0,0:00:11.30,0:00:12.54,Sub,,0,0,0,,{\c&HF2F4F6&}THEY TOOK YOUR FOOD.
Dialogue: 0,0:00:12.54,0:00:13.91,Sub,,0,0,0,,{\c&HF2F4F6&}THEY LEFT YOU BEHIND.
Dialogue: 0,0:00:14.20,0:00:14.94,Sub,,0,0,0,,{\c&HF2F4F6&}OUT HERE,
Dialogue: 0,0:00:14.94,0:00:16.76,Sub,,0,0,0,,{\c&HF2F4F6&}WEAKNESS IS A {\c&H30B8F0&}DEATH SENTENCE{\c&HF2F4F6&}.
Dialogue: 0,0:00:17.00,0:00:18.36,Sub,,0,0,0,,{\c&HF2F4F6&}THEN THE {\c&H30B8F0&}KNIGHTS{\c&HF2F4F6&} CAME.
Dialogue: 0,0:00:19.10,0:00:20.22,Sub,,0,0,0,,{\c&HF2F4F6&}YOUR HOME {\c&H30B8F0&}BURNED{\c&HF2F4F6&}.
Dialogue: 0,0:00:20.22,0:00:21.38,Sub,,0,0,0,,{\c&HF2F4F6&}YOUR TRIBE FELL.
Dialogue: 0,0:00:21.90,0:00:22.94,Sub,,0,0,0,,{\c&HF2F4F6&}AND {\c&H30B8F0&}YOU RAN{\c&HF2F4F6&}.
Dialogue: 0,0:00:23.50,0:00:25.07,Sub,,0,0,0,,{\c&HF2F4F6&}ALONE, YOU LEARNED TO {\c&H30B8F0&}HUNT{\c&HF2F4F6&}.
Dialogue: 0,0:00:25.07,0:00:26.19,Sub,,0,0,0,,{\c&HF2F4F6&}TO MAKE {\c&H30B8F0&}WEAPONS{\c&HF2F4F6&}.
Dialogue: 0,0:00:26.70,0:00:27.61,Sub,,0,0,0,,{\c&HF2F4F6&}TO KILL THINGS
Dialogue: 0,0:00:27.61,0:00:29.01,Sub,,0,0,0,,{\c&HF2F4F6&}THAT WANTED TO EAT YOU.
Dialogue: 0,0:00:29.70,0:00:30.84,Sub,,0,0,0,,{\c&HF2F4F6&}SEASONS PASSED.
Dialogue: 0,0:00:30.84,0:00:31.83,Sub,,0,0,0,,{\c&HF2F4F6&}THEN {\c&H30B8F0&}YEARS{\c&HF2F4F6&}.
Dialogue: 0,0:00:32.90,0:00:34.46,Sub,,0,0,0,,{\c&HF2F4F6&}UNTIL YOU KILLED SOMETHING
Dialogue: 0,0:00:34.46,0:00:36.25,Sub,,0,0,0,,{\c&HF2F4F6&}FAR {\c&H30B8F0&}STRONGER{\c&HF2F4F6&} THAN YOURSELF...
Dialogue: 0,0:00:37.60,0:00:38.93,Sub,,0,0,0,,{\c&HF2F4F6&}AND TOOK ITS {\c&H30B8F0&}ARMOR{\c&HF2F4F6&}.
Dialogue: 0,0:00:40.00,0:00:41.94,Sub,,0,0,0,,{\c&HF2F4F6&}{\c&H30B8F0&}GOBLIN{\c&HF2F4F6&}S BEGAN TO {\c&H30B8F0&}FOLLOW YOU{\c&HF2F4F6&}.
Dialogue: 0,0:00:43.40,0:00:44.98,Sub,,0,0,0,,{\c&HF2F4F6&}{\c&H30B8F0&}YEARS{\c&HF2F4F6&} LATER, YOU CAME BACK...
Dialogue: 0,0:00:44.98,0:00:45.89,Sub,,0,0,0,,{\c&HF2F4F6&}TO THE KINGDOM
Dialogue: 0,0:00:45.89,0:00:47.23,Sub,,0,0,0,,{\c&HF2F4F6&}THAT {\c&H30B8F0&}BURNED{\c&HF2F4F6&} YOUR HOME.
Dialogue: 0,0:00:47.80,0:00:49.69,Sub,,0,0,0,,{\c&HF2F4F6&}THE {\c&H30B8F0&}KNIGHTS{\c&HF2F4F6&} WHO ONCE {\c&H30B8F0&}HUNT{\c&HF2F4F6&}ED YOU...
Dialogue: 0,0:00:49.69,0:00:50.24,Sub,,0,0,0,,{\c&HF2F4F6&}{\c&H30B8F0&}RAN.{\c&HF2F4F6&}
Dialogue: 0,0:00:53.60,0:00:54.83,Sub,,0,0,0,,{\c&HF2F4F6&}AND THE {\c&H30B8F0&}WEAKEST{\c&HF2F4F6&} {\c&H30B8F0&}GOBLIN{\c&HF2F4F6&}
Dialogue: 0,0:00:54.83,0:00:55.88,Sub,,0,0,0,,{\c&HF2F4F6&}IN THE FOREST...
Dialogue: 0,0:00:56.40,0:00:57.52,Sub,,0,0,0,,{\c&HF2F4F6&}{\c&H30B8F0&}BECAME THE KING{\c&HF2F4F6&}
Dialogue: 0,0:00:57.52,0:00:59.04,Sub,,0,0,0,,{\c&HF2F4F6&}OF AN ENTIRE KINGDOM.
