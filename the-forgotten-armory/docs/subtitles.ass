Dialogue: 0,0:00:00.25,0:00:04.60,Hook,,0,0,0,,{\fad(250,300)}VHALDREN · EPISODE III
Dialogue: 0,0:00:00.30,0:00:02.17,Sub,,0,0,0,,{\c&HF2F4F6&}EVERY KNIGHT HAS A STORY.
Dialogue: 0,0:00:02.40,0:00:03.23,Sub,,0,0,0,,{\c&HF2F4F6&}BUT SOME...
Dialogue: 0,0:00:03.23,0:00:04.44,Sub,,0,0,0,,{\c&HF2F4F6&}INHERIT A {\c&H6AB4D8&}LEGACY{\c&HF2F4F6&}.
Dialogue: 0,0:00:05.90,0:00:08.06,Sub,,0,0,0,,{\c&HF2F4F6&}DEEP WITHIN A FORGOTTEN FORTRESS,
Dialogue: 0,0:00:08.06,0:00:09.77,Sub,,0,0,0,,{\c&HF2F4F6&}{\c&H6AB4D8&}CAEL{\c&HF2F4F6&} DISCOVERED SOMETHING
Dialogue: 0,0:00:09.77,0:00:11.18,Sub,,0,0,0,,{\c&HF2F4F6&}{\c&H6AB4D8&}UNTOUCHED BY TIME{\c&HF2F4F6&}.
Dialogue: 0,0:00:16.90,0:00:18.26,Sub,,0,0,0,,{\c&HF2F4F6&}AN ARMOR ONCE WORN
Dialogue: 0,0:00:18.26,0:00:20.23,Sub,,0,0,0,,{\c&HF2F4F6&}BY THE {\c&H6AB4D8&}GUARDIANS{\c&HF2F4F6&} OF A KINGDOM
Dialogue: 0,0:00:20.23,0:00:21.89,Sub,,0,0,0,,{\c&HF2F4F6&}THAT NO LONGER EXISTS.
Dialogue: 0,0:00:25.20,0:00:26.41,Sub,,0,0,0,,{\c&HF2F4F6&}WHEN HE TOUCHED IT,
Dialogue: 0,0:00:26.41,0:00:27.53,Sub,,0,0,0,,{\c&HF2F4F6&}AN OLD {\c&H6AB4D8&}SIGIL{\c&HF2F4F6&} WOKE
Dialogue: 0,0:00:27.53,0:00:28.82,Sub,,0,0,0,,{\c&HF2F4F6&}BENEATH HIS HAND...
Dialogue: 0,0:00:29.00,0:00:30.02,Sub,,0,0,0,,{\c&HF2F4F6&}THE SAME SIGN
Dialogue: 0,0:00:30.02,0:00:31.92,Sub,,0,0,0,,{\c&HF2F4F6&}HE HAD CARRIED ALL HIS LIFE.
Dialogue: 0,0:00:32.20,0:00:33.27,Sub,,0,0,0,,{\c&HF2F4F6&}PIECE BY PIECE,
Dialogue: 0,0:00:33.27,0:00:35.13,Sub,,0,0,0,,{\c&HF2F4F6&}HE ABANDONED HIS {\c&H6AB4D8&}OLD ARMOR{\c&HF2F4F6&}...
Dialogue: 0,0:00:36.90,0:00:38.62,Sub,,0,0,0,,{\c&HF2F4F6&}AND INHERITED THE {\c&H6AB4D8&}LEGACY{\c&HF2F4F6&}
Dialogue: 0,0:00:38.62,0:00:40.71,Sub,,0,0,0,,{\c&HF2F4F6&}OF THOSE WHO CAME BEFORE HIM.
Dialogue: 0,0:00:44.80,0:00:46.41,Sub,,0,0,0,,{\c&HF2F4F6&}SOMEWHERE IN THE DARKNESS,
Dialogue: 0,0:00:46.41,0:00:47.51,Sub,,0,0,0,,{\c&HF2F4F6&}AN {\c&H6AB4D8&}ANCIENT ORDER{\c&HF2F4F6&}
Dialogue: 0,0:00:47.51,0:00:49.09,Sub,,0,0,0,,{\c&HF2F4F6&}HAD FOUND ITS {\c&H6AB4D8&}SUCCESSOR{\c&HF2F4F6&}.
Dialogue: 0,0:00:55.70,0:00:56.78,Sub,,0,0,0,,{\c&HF2F4F6&}AND THIS TIME...
Dialogue: 0,0:00:56.78,0:00:58.62,Sub,,0,0,0,,{\c&HF2F4F6&}HE WOULD NOT WALK {\c&H6AB4D8&}UNPROTECTED{\c&HF2F4F6&}.
