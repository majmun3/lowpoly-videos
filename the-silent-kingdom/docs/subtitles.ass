Dialogue: 0,0:00:00.25,0:00:01.84,Sub,,0,0,0,,{\c&HF2F4F6&}WHAT IF YOU FOUND A KINGDOM
Dialogue: 0,0:00:00.25,0:00:05.30,Hook,,0,0,0,,{\fad(250,300)}VHALDREN · EPISODE II
Dialogue: 0,0:00:01.84,0:00:03.40,Sub,,0,0,0,,{\c&HF2F4F6&}WHERE {\c&H4CC0F0&}{\c&H4CC0F0&}NOBODY{\c&HF2F4F6&}{\c&HF2F4F6&} COULD DIE...
Dialogue: 0,0:00:03.35,0:00:04.25,Sub,,0,0,0,,{\c&HF2F4F6&}BUT {\c&H4CC0F0&}{\c&H4CC0F0&}NOBODY{\c&HF2F4F6&}{\c&HF2F4F6&}
Dialogue: 0,0:00:04.25,0:00:05.57,Sub,,0,0,0,,{\c&HF2F4F6&}WAS TRULY ALIVE?
Dialogue: 0,0:00:05.85,0:00:07.33,Sub,,0,0,0,,{\c&HF2F4F6&}BEYOND THE FROZEN PEAKS
Dialogue: 0,0:00:07.33,0:00:08.24,Sub,,0,0,0,,{\c&HF2F4F6&}OF {\c&H4CC0F0&}VHALDREN{\c&HF2F4F6&},
Dialogue: 0,0:00:08.24,0:00:09.55,Sub,,0,0,0,,{\c&HF2F4F6&}I FOUND {\c&H4CC0F0&}AURELMOOR{\c&HF2F4F6&}.
Dialogue: 0,0:00:09.80,0:00:10.65,Sub,,0,0,0,,{\c&HF2F4F6&}FROM AFAR,
Dialogue: 0,0:00:10.65,0:00:12.04,Sub,,0,0,0,,{\c&HF2F4F6&}A CITY OF A THOUSAND
Dialogue: 0,0:00:12.04,0:00:13.18,Sub,,0,0,0,,{\c&HF2F4F6&}{\c&H4CC0F0&}GOLDEN LIGHTS{\c&HF2F4F6&}.
Dialogue: 0,0:00:13.60,0:00:14.46,Sub,,0,0,0,,{\c&HF2F4F6&}UP CLOSE...
Dialogue: 0,0:00:14.46,0:00:15.42,Sub,,0,0,0,,{\c&HF2F4F6&}{\c&H4CC0F0&}{\c&H4CC0F0&}NOBODY{\c&HF2F4F6&}{\c&HF2F4F6&} SPOKE.
Dialogue: 0,0:00:15.42,0:00:16.37,Sub,,0,0,0,,{\c&HF2F4F6&}{\c&H4CC0F0&}{\c&H4CC0F0&}NOBODY{\c&HF2F4F6&}{\c&HF2F4F6&} MOVED.
Dialogue: 0,0:00:16.37,0:00:17.56,Sub,,0,0,0,,{\c&HF2F4F6&}{\c&H4CC0F0&}{\c&H4CC0F0&}NOBODY{\c&HF2F4F6&}{\c&HF2F4F6&} BREATHED.
Dialogue: 0,0:00:18.00,0:00:19.80,Sub,,0,0,0,,{\c&HF2F4F6&}SNOW LAY ON THEIR SHOULDERS,
Dialogue: 0,0:00:19.80,0:00:21.63,Sub,,0,0,0,,{\c&HF2F4F6&}AS IF IT HAD FOR CENTURIES.
Dialogue: 0,0:00:22.00,0:00:22.93,Sub,,0,0,0,,{\c&HF2F4F6&}THEN ONE OF THEM
Dialogue: 0,0:00:22.93,0:00:23.95,Sub,,0,0,0,,{\c&HF2F4F6&}TURNED ITS HEAD.
Dialogue: 0,0:00:24.35,0:00:25.74,Sub,,0,0,0,,{\c&HF2F4F6&}IT HAD {\c&H4CC0F0&}NO FACE{\c&HF2F4F6&}.
Dialogue: 0,0:00:26.00,0:00:27.68,Sub,,0,0,0,,{\c&HF2F4F6&}AND EVERY SOUL IN {\c&H4CC0F0&}AURELMOOR{\c&HF2F4F6&}
Dialogue: 0,0:00:27.68,0:00:28.45,Sub,,0,0,0,,{\c&HF2F4F6&}TURNED...
Dialogue: 0,0:00:28.45,0:00:29.35,Sub,,0,0,0,,{\c&HF2F4F6&}{\c&H4CC0F0&}TOWARD ME{\c&HF2F4F6&}.
Dialogue: 0,0:00:32.60,0:00:33.79,Sub,,0,0,0,,{\c&HF2F4F6&}THEY CAME FOR ME.
Dialogue: 0,0:00:33.79,0:00:35.42,Sub,,0,0,0,,{\c&HF2F4F6&}BUT THEY DID NOT ATTACK.
Dialogue: 0,0:00:35.80,0:00:36.95,Sub,,0,0,0,,{\c&HF2F4F6&}THEY WERE POINTING.
Dialogue: 0,0:00:36.95,0:00:37.53,Sub,,0,0,0,,{\c&HF2F4F6&}{\c&H4CC0F0&}DOWN{\c&HF2F4F6&}.
Dialogue: 0,0:00:38.00,0:00:39.07,Sub,,0,0,0,,{\c&HF2F4F6&}BENEATH THE CITY,
Dialogue: 0,0:00:39.07,0:00:40.81,Sub,,0,0,0,,{\c&HF2F4F6&}SOMETHING WAS STILL BREATHING.
Dialogue: 0,0:00:41.30,0:00:41.97,Sub,,0,0,0,,{\c&HF2F4F6&}{\c&H4CC0F0&}A MACHINE{\c&HF2F4F6&}
Dialogue: 0,0:00:41.97,0:00:43.63,Sub,,0,0,0,,{\c&HF2F4F6&}THAT HAD STOLEN THEIR DEATHS...
Dialogue: 0,0:00:43.63,0:00:44.79,Sub,,0,0,0,,{\c&HF2F4F6&}AND KEPT THEIR SOULS
Dialogue: 0,0:00:44.79,0:00:45.72,Sub,,0,0,0,,{\c&HF2F4F6&}FROM LEAVING.
Dialogue: 0,0:00:46.10,0:00:47.40,Sub,,0,0,0,,{\c&HF2F4F6&}AND WHEN IT SAW ME...
Dialogue: 0,0:00:47.40,0:00:48.16,Sub,,0,0,0,,{\c&HF2F4F6&}IT WOKE.
Dialogue: 0,0:00:48.60,0:00:49.44,Sub,,0,0,0,,{\c&HF2F4F6&}IT WAS NEVER
Dialogue: 0,0:00:49.44,0:00:50.69,Sub,,0,0,0,,{\c&HF2F4F6&}KEEPING THEM ALIVE.
Dialogue: 0,0:00:50.90,0:00:52.40,Sub,,0,0,0,,{\c&HF2F4F6&}IT WAS WAITING FOR SOMEONE
Dialogue: 0,0:00:52.40,0:00:53.47,Sub,,0,0,0,,{\c&HF2F4F6&}WHO COULD FINALLY
Dialogue: 0,0:00:53.47,0:00:54.49,Sub,,0,0,0,,{\c&HF2F4F6&}{\c&H4CC0F0&}SWITCH IT OFF{\c&HF2F4F6&}.
Dialogue: 0,0:00:55.00,0:00:56.76,Sub,,0,0,0,,{\c&HF2F4F6&}SOME KINGDOMS {\c&H4CC0F0&}FEAR DEATH{\c&HF2F4F6&}.
Dialogue: 0,0:00:57.85,0:00:58.64,Sub,,0,0,0,,{\c&HF2F4F6&}OTHERS FEAR
Dialogue: 0,0:00:58.64,0:00:59.94,Sub,,0,0,0,,{\c&HF2F4F6&}WHAT COMES {\c&H4CC0F0&}AFTER IT{\c&HF2F4F6&}.
Dialogue: 0,0:01:00.00,0:01:03.00,Title,,0,0,0,,{\fad(500,0)}THE SILENT KINGDOM
Dialogue: 0,0:01:00.60,0:01:03.00,Ask,,0,0,0,,{\fad(400,0)}WOULD YOU HAVE\NDESTROYED THE MACHINE?\N{\fs40}{\c&H4CC0F0&}TELL ME IN THE COMMENTS
